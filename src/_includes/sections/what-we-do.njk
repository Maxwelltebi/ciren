<section class="py-20 lg:py-28 bg-white relative overflow-hidden" id="about-us">
<div class="max-w-7xl mx-auto px-6 lg:px-8">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
<!-- Left Column: Image with floating badge matching reference -->
<div class="lg:col-span-6 relative">
<div class="relative overflow-hidden shadow-2xl bg-slate-100 aspect-[4/3] sm:aspect-[16/11] rounded-[2rem]">
<img alt="CIReN student researchers collaborating at campus tech lab" class="w-full h-full object-cover object-center transform hover:scale-105 transition-transform duration-700" src="/assets/images/students-collaborating.jpg">
<div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent pointer-events-none"></div>
<!-- Floating Badge Card (Bottom Left, mirroring reference) -->
<div class="absolute bottom-5 left-5 sm:bottom-7 sm:left-7 bg-white/95 backdrop-blur-md px-5 py-4 shadow-xl border border-white/60 flex items-center gap-4 z-10 max-w-[90%] sm:max-w-sm rounded-none">
<div class="flex items-center -space-x-3 shrink-0"><div class="w-9 h-9 rounded-none ring-2 ring-white overflow-hidden bg-slate-200"><img alt="Student Avatar" class="w-full h-full object-cover" src="/assets/images/student-avatar-1.jpg"></div><div class="w-9 h-9 rounded-none ring-2 ring-white overflow-hidden bg-slate-200"><img alt="Student Avatar" class="w-full h-full object-cover" src="/assets/images/student-avatar-2.jpg"></div><div class="w-9 h-9 rounded-none ring-2 ring-white overflow-hidden bg-slate-200"><img alt="Student Avatar" class="w-full h-full object-cover" src="/assets/images/student-avatar-3.jpg"></div><div class="w-9 h-9 rounded-none ring-2 ring-white bg-[#046e00] flex items-center justify-center text-[10px] font-bold text-white shadow-sm">4.2k+</div></div>
<div class="text-left">
<p class="text-xs sm:text-[13px] font-bold text-[#0B0F19] leading-tight">{{ home.whatWeDo.badgeLine1 | safe }}</p>
<p class="text-[11px] sm:text-xs font-semibold text-[#046e00]">{{ home.whatWeDo.badgeLine2 | safe }}</p>
</div>
</div>
</div>
</div>
<!-- Right Column: Content matching reference text structure -->
<div class="lg:col-span-6 flex flex-col items-start justify-center">
<!-- Eyebrow with colored underline accent -->
<div class="mb-6 inline-block">
<span class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#0B0F19]" style="font-family: &quot;Playfair Display&quot;, Georgia, serif; letter-spacing: 0.12em;">{{ home.whatWeDo.eyebrow | safe }}</span>
<div class="h-1 w-12 bg-[#40b830] rounded-full mt-1.5"></div>
</div>
<!-- Description paragraphs -->
<div class="space-y-4 text-slate-600 font-normal leading-relaxed text-sm sm:text-base mb-8">
{% for p in home.whatWeDo.paragraphs %}<p class="">{{ p | safe }}</p>{% endfor %}
</div>
<!-- Call to action button -->
<a class="inline-flex items-center gap-2.5 px-8 py-3.5 bg-[#40b830] hover:bg-[#329e24] text-white font-semibold text-sm rounded-none shadow-lg shadow-[#046e00]/20 hover:shadow-xl hover:-translate-y-0.5 transition-all" href="/programs/"><span class="">{{ home.whatWeDo.ctaLabel | safe }}</span><svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
</div>
</div>
</div>
</section>
