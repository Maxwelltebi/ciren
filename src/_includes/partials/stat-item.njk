{# One marquee metric plus its trailing divider. Data: src/_data/stats.json #}
<div class="flex items-baseline gap-3"><span class="text-3xl lg:text-4xl font-extrabold {{ s.colourClass }}">{{ s.value | safe }}</span><span class="text-xs font-semibold text-slate-600 uppercase tracking-wider whitespace-nowrap">{{ s.label | safe }}</span></div><div class="h-8 w-px bg-slate-200/90 shrink-0"></div>