<section class="py-20 lg:py-28 bg-gradient-to-b from-white via-[#f8f9ff] to-white overflow-hidden relative" id="testimonies">
<div class="max-w-7xl mx-auto px-6 lg:px-8 text-center mb-14">
<h2 class="text-3xl sm:text-4xl lg:text-5xl uppercase tracking-tight mb-4 text-slate-800 font-bold" style="font-family: &quot;Playfair Display&quot;, Georgia, serif; font-weight: 700; letter-spacing: -0.01em;">Stories from African Campus Labs &amp; Hackathons</h2>
<p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto font-normal leading-relaxed">
      Hear directly from university students, hackathon champions, and peer-reviewed student researchers whose careers were ignited through CIReN's campus network.
    </p>
</div>
<!-- Carousel Viewport & Fanned Overlapping Deck -->
<div class="relative w-full max-w-[1360px] mx-auto px-4 sm:px-6">
<div class="hide-scrollbar flex items-center overflow-x-auto py-12 px-8 sm:px-16 scroll-smooth snap-x snap-mandatory -space-x-8 sm:-space-x-12 md:-space-x-14 select-none" id="carousel-deck" style="--card-heading-font: 'Playfair Display', Georgia, serif;">
<!-- Card 1: Kofi Mensah (Ashesi, Ghana) -->
{% for t in testimonials %}{% include "partials/testimonial-card.njk" %}{% endfor %}
</div>
<!-- Carousel Controls (Matches reference image UI) -->
<div class="flex items-center justify-center gap-6 mt-8">
<button aria-label="Previous testimony" class="w-11 h-11 border border-slate-300 hover:border-[#40b830] bg-white hover:bg-slate-50 text-slate-700 hover:text-[#046e00] shadow-sm flex items-center justify-center transition-all duration-200 active:scale-95 focus:outline-none focus:ring-2 focus:ring-[#40b830]/40 rounded-none" id="carousel-prev">
<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
</button>
<!-- Pagination track dots -->
<div class="flex items-center gap-2" id="carousel-dots">
<button class="w-2.5 h-2.5 rounded-full bg-slate-300 hover:bg-slate-400 transition-all focus:outline-none" data-index="0"></button>
<button class="w-2.5 h-2.5 rounded-full bg-[#0B0F19] ring-2 ring-[#40b830]/40 transition-all focus:outline-none" data-index="1"></button>
<button class="w-2.5 h-2.5 rounded-full bg-slate-300 hover:bg-slate-400 transition-all focus:outline-none" data-index="2"></button>
<button class="w-2.5 h-2.5 rounded-full bg-slate-300 hover:bg-slate-400 transition-all focus:outline-none" data-index="3"></button>
<button class="w-2.5 h-2.5 rounded-full bg-slate-300 hover:bg-slate-400 transition-all focus:outline-none" data-index="4"></button>
<button class="w-2.5 h-2.5 rounded-full bg-slate-300 hover:bg-slate-400 transition-all focus:outline-none" data-index="5"></button>
</div>
<button aria-label="Next testimony" class="w-11 h-11 border border-slate-300 hover:border-[#40b830] bg-white hover:bg-slate-50 text-slate-700 hover:text-[#046e00] shadow-sm flex items-center justify-center transition-all duration-200 active:scale-95 focus:outline-none focus:ring-2 focus:ring-[#40b830]/40 rounded-none" id="carousel-next">
<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
</button>
</div>
</div>
</section>
