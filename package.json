{
  "name": "ciren-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Campus Innovation & Research Network — React + TypeScript",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
