{
  "name": "ciren-website",
  "version": "1.0.0",
  "private": true,
  "description": "CIReN - Campus Innovation & Research Network landing page",
  "scripts": {
    "build:html": "eleventy",
    "build:css": "tailwindcss -i ./src/css/main.css -o ./dist/css/main.css --minify",
    "build": "npm run build:html && npm run build:css",
    "dev:html": "eleventy --serve",
    "dev:css": "tailwindcss -i ./src/css/main.css -o ./dist/css/main.css --watch",
    "dev": "npm-run-all --parallel dev:html dev:css",
    "verify": "node tools/verify.mjs && node tools/behaviour.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "jsdom": "^30.0.1",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.17"
  }
}
