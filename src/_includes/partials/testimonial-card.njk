{# One testimonial card. Data: src/_data/testimonials.json #}
<div tabindex="0" role="button" aria-haspopup="dialog" class="focus:outline-none focus:ring-4 focus:ring-[#40b830]/60 carousel-card flex-shrink-0 w-[270px] sm:w-[310px] md:w-[330px] {% if t.featured %}h-[500px] sm:h-[550px]{% else %}h-[480px] sm:h-[530px]{% endif %} rounded-[2rem] overflow-hidden relative shadow-2xl transition-all duration-500 transform {{ t.rotate }}{% if t.rotate != 'rotate-0' %} hover:rotate-0{% endif %} hover:-translate-y-6 hover:scale-105 hover:z-30 cursor-pointer snap-center group {% if t.featured %}border-2 border-[#40b830]/40 {%- else %}border border-white/20 {%- endif %}">
<img alt="{{ t.alt | safe }}" class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-110" src="{{ t.image | safe }}">
<div class="absolute inset-0 bg-gradient-to-t from-black {% if t.featured %}via-black/65 to-black/15{% else %}via-black/60 to-black/20{% endif %}"></div>
<div class="relative z-10 h-full p-6 sm:p-7 flex flex-col justify-between text-white">
<div class="flex items-center justify-between">
<span class="inline-flex items-center px-3 py-1 text-[11px] font-bold tracking-wider uppercase bg-[#40b830] text-white shadow-sm rounded-none">
              {{ t.badge | safe }}
            </span>

</div>
<div>
<div class="mb-3 text-[#68e053]">
<svg class="w-8 h-8 opacity-80" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"></path></svg>
</div>
<p class="text-sm sm:text-base font-normal leading-relaxed text-slate-100 mb-5 line-clamp-4">
              {{ t.quote | safe }}
            </p>
<div class="border-t border-white/20 pt-4 flex items-center gap-3">
<div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center font-bold text-xs text-white border border-white/30">{{ t.initials | safe }}</div>
<div>
<h4 class="text-sm sm:text-base font-bold text-white leading-tight" style="font-family: 'Playfair Display', Georgia, serif;">{{ t.name | safe }}</h4>
<p class="text-xs text-emerald-300 font-medium">{{ t.university | safe }}</p>
</div>
</div>
</div>
</div>
</div>
<!-- Card 2: Amina Bello (Univ of Ibadan, Nigeria) -->
