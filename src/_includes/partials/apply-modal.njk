{# Membership application dialog, opened by the header's Apply button.
   Fields come from src/_data/applyForm.json - add or reorder them there, not
   here. Input styling follows the newsletter form: rounded-none, #40b830 focus
   ring. Lives at page level so no ancestor's overflow can clip it. #}
<div id="apply-modal"
     class="fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-6"
     role="dialog" aria-modal="true" aria-labelledby="apply-modal-title">
  <div data-modal-backdrop class="absolute inset-0 bg-black/80 backdrop-blur-sm"></div>

  <div class="relative z-10 w-full max-w-xl max-h-[90vh] overflow-y-auto hide-scrollbar rounded-[2rem] bg-white shadow-2xl">
    <button data-modal-close type="button" aria-label="Close application form"
            class="absolute right-4 top-4 z-20 w-9 h-9 flex items-center justify-center rounded-full bg-black/40 text-white backdrop-blur-md border border-white/20 transition-colors hover:bg-[#40b830] focus:outline-none focus:ring-2 focus:ring-[#40b830]">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
      </svg>
    </button>

    <div class="bg-[#0B0F19] px-6 py-7 sm:px-8">
      <div class="h-1 w-12 bg-[#40b830] rounded-full mb-4"></div>
      <h3 id="apply-modal-title"
          class="text-2xl sm:text-3xl font-bold text-white leading-tight tracking-tight"
          style="font-family: &quot;Playfair Display&quot;, Georgia, serif;">
        {{ applyForm.title }}
      </h3>
      <p class="text-sm text-slate-300 font-normal mt-2 max-w-md">{{ applyForm.intro }}</p>
    </div>

    <form id="apply-form" class="px-6 py-7 sm:px-8 space-y-5"
          {% if applyForm.action %}action="{{ applyForm.action }}" method="post"{% endif %}>
      {% set idPrefix = "apply" %}
      {% for f in applyForm.fields %}{% include "partials/form-field.njk" %}{% endfor %}

      {# Announced to screen readers when submission finishes. #}
      <div id="apply-form-status" role="status" aria-live="polite" class="hidden text-sm px-4 py-3"></div>

      <button type="submit"
              class="w-full h-11 px-6 bg-[#40b830] hover:bg-[#329e24] text-white text-xs sm:text-sm font-bold uppercase tracking-wider rounded-none transition-colors shadow-md flex items-center justify-center gap-2 focus:outline-none focus:ring-2 focus:ring-[#046e00]">
        <span>{{ applyForm.submitLabel }}</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </form>
  </div>
</div>
